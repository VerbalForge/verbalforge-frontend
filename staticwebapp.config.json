{
	"platform": {
		"apiRuntime": "node:20"
	},
	"routes": [
		{
			"route": "/*",
			"allowedRoles": ["anonymous"]
		}
	],
	"navigationFallback": {
		"rewrite": "/_next/server.js",
		"exclude": ["/_next/*", "/static/*", "/*.{css,scss,sass,js,jsx,ts,tsx,json,png,jpg,jpeg,gif,svg,ico,woff,woff2,ttf,eot}"]
	}
}
